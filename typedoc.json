{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "./packages/core/*/src/index.ts",
    "./packages/core/devtools/src/bootstrap.ts",
    "./packages/hosts/*/src/index.ts",
    "./packages/addons/*/src/index.ts",
    "./packages/ui/*/src/index.ts",
    "./packages/mounts/*/src/index.ts",
    "./packages/tools/*/src/index.ts"
  ],
  "entryPointStrategy": "resolve",
  "tsconfig": "./tsconfig.docs.json",
  "out": "./docs/api/reference",
  "entryFileName": "index.md",
  "mergeReadme": true,
  "name": "3Lens API Reference",
  "readme": "./docs/guides/GETTING-STARTED.md",
  "includeVersion": true,
  "excludePrivate": true,
  "excludeProtected": false,
  "excludeInternal": true,
  "excludeExternals": true,
  "hideGenerator": false,
  "searchInComments": true,
  "categorizeByGroup": true,
  "defaultCategory": "Other",
  "categoryOrder": [
    "Core",
    "Probe",
    "Configuration",
    "Helpers",
    "Tracking",
    "Entities",
    "Plugins",
    "Adapters",
    "Transport",
    "Utilities",
    "Types",
    "Overlay",
    "React",
    "Angular",
    "Vue",
    "UI",
    "Other"
  ],
  "sort": ["source-order", "alphabetical"],
  "visibilityFilters": {
    "protected": true,
    "@internal": false
  },
  "navigation": {
    "includeCategories": true,
    "includeGroups": true
  },
  "gitRevision": "main",
  "sourceLinkTemplate": "https://github.com/adriandarian/3Lens/blob/{gitRevision}/{path}#L{line}",
  "customCss": "./docs/api-styles.css",
  "skipErrorChecking": true,
  "plugin": ["typedoc-plugin-markdown"],
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": false
  },
  "treatWarningsAsErrors": false,
  "logLevel": "Warn"
}
